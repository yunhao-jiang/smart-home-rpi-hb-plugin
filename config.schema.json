{
  "pluginAlias": "Raspberry Pi Smart Home",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "properties": {
      "IP Address": {
        "title": "IP Address",
        "type": "string",
        "required": true,
        "default": "127.0.0.1"
      },
      "Port": {
        "title": "Port",
        "type": "number",
        "required": true,
        "default": 8080
      }
    }
  }
}
